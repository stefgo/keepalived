# Template: copy to .env and adjust. The .env file is not committed.

# Time zone of the container
TZ=Europe/Berlin

# Optional: router id in global_defs (default: hostname)
KEEPALIVED_ROUTER_ID=

# --- Defaults for all instances ---------------------------------------------
# Every VRRP_<n>_<KEY> falls back to VRRP_<KEY> (except NAME).
VRRP_INTERFACE=eth0
VRRP_ADVERT_INT=1
# Optional: command called on every state change; notify-log.sh is part of the
# image and writes the change to the container log
VRRP_NOTIFY=/usr/local/bin/notify-log.sh

# --- Instance 1 -------------------------------------------------------------
# Instances are numbered consecutively starting at 1.
VRRP_1_NAME=VI_LAN
# MASTER or BACKUP; the peer host gets BACKUP and a lower priority
VRRP_1_STATE=MASTER
# Must be identical on all hosts of this virtual router (1-255)
VRRP_1_VIRTUAL_ROUTER_ID=51
VRRP_1_PRIORITY=150
# Comma-separated; an entry may carry keepalived options such as "dev" or "label"
VRRP_1_VIRTUAL_IPS=192.168.1.100/24
# Optional: at most 8 characters, identical on all hosts
VRRP_1_AUTH_PASS=changeme
# Optional: names of vrrp_scripts defined below (space- or comma-separated)
VRRP_1_TRACK_SCRIPTS=chk_dns

# --- Instance 2 (optional) --------------------------------------------------
VRRP_2_STATE=BACKUP
VRRP_2_INTERFACE=eth1
VRRP_2_VIRTUAL_ROUTER_ID=52
VRRP_2_PRIORITY=100
VRRP_2_VIRTUAL_IPS=10.0.0.100/24, 10.0.0.101/24
# Optional: unicast instead of multicast
VRRP_2_UNICAST_SRC_IP=10.0.0.10
VRRP_2_UNICAST_PEERS=10.0.0.11
# Optional: do not take the address back after a failover (requires BACKUP)
VRRP_2_NOPREEMPT=true
# Optional: go to FAULT state if one of these interfaces is down
VRRP_2_TRACK_INTERFACES=eth0
# Optional: commands called only when entering one specific state
#VRRP_2_NOTIFY_MASTER=/etc/keepalived/scripts/on-master.sh
#VRRP_2_NOTIFY_BACKUP=/etc/keepalived/scripts/on-backup.sh
#VRRP_2_NOTIFY_FAULT=/etc/keepalived/scripts/on-fault.sh
#VRRP_2_NOTIFY_STOP=/etc/keepalived/scripts/on-stop.sh

# --- Script 1 (optional) ----------------------------------------------------
# Scripts are numbered consecutively starting at 1 and referenced by name.
VRRP_SCRIPT_1_NAME=chk_dns
# Command or path to a script; must not contain double quotes
VRRP_SCRIPT_1_SCRIPT=/usr/bin/nc -z -w 1 127.0.0.1 53
VRRP_SCRIPT_1_INTERVAL=2
VRRP_SCRIPT_1_TIMEOUT=2
# Consecutive failures / successes before the state changes
VRRP_SCRIPT_1_FALL=2
VRRP_SCRIPT_1_RISE=2
# Optional: change the priority by this value instead of entering FAULT state
VRRP_SCRIPT_1_WEIGHT=-60
